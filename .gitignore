######################################
#          Git ignore file           #
# https://git-scm.com/docs/gitignore #
######################################

# Editor/IDE
.idea/*
!.idea/externalDependencies.xml
!.idea/icon.svg
.vscode/*
!.vscode/extensions.json

# Dependencies
node_modules/
.pnp/
.yarn/
.pnp.*
package-lock.json
yarn.lock

# TypeScript
*.tsbuildinfo

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.size-limit/
esbuild-why-*

# Build
/dist/
*.tgz

# Temporary Files
scratch.*
scribble.*
