/***********************************************/
/*              Biome config file              */
/* https://biomejs.dev/guides/configure-biome/ */
/***********************************************/

{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"formatter": {
		"enabled": true,
		"useEditorconfig": true,
		"includes": [
			"**",
			"!tsconfig.json"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"preset": "recommended"
		}
	},
	"json": {
		"formatter": {
			"expand": "always"
		}
	}
}
